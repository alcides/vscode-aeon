{
  "name": "aeon-lang",
  "displayName": "Æon Language",
  "description": "Aeon language support for VS Code",
  "version": "0.0.27",
  "publisher": "AlcidesFonseca",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "Aeon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alcides/vscode-aeon.git"
  },
  "homepage": "https://github.com/alcides/aeon",
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Aeon",
      "properties": {
        "aeon.environmentPath": {
          "type": "string",
          "default": "",
          "description": "Path to the environment which aeon will be installed on."
        },
        "aeon.useSystemInterpreter": {
          "type": "boolean",
          "default": false,
          "description": "If true, uses the system-wide Aeon interpreter instead of the local virtual environment."
        },
        "aeon.localPackagePath": {
          "type": "string",
          "default": "",
          "description": "Path to a local aeon Python package folder to use instead of the published PyPI package. When set, the language server is launched with 'uvx --from <path>' instead of 'uvx --from aeonlang'."
        },
        "aeon.input.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Lean-style Unicode input method. Type the leader followed by an abbreviation (e.g. \\to) to insert a Unicode symbol (→)."
        },
        "aeon.input.leader": {
          "type": "string",
          "default": "\\",
          "maxLength": 1,
          "minLength": 1,
          "description": "The character that starts a Unicode abbreviation. Defaults to the backslash."
        },
        "aeon.input.eagerReplacement": {
          "type": "boolean",
          "default": true,
          "description": "Replace an abbreviation as soon as it is unambiguous, without waiting for a terminating character."
        },
        "aeon.defaultSynthesizer": {
          "type": "string",
          "default": "gp",
          "enum": [
            "backward_abs",
            "backward_app",
            "backward_close",
            "tdsyn_backward",
            "backward_if",
            "backward_lit",
            "forward_close",
            "forward_let_abs",
            "forward_let_app",
            "forward_let_if",
            "forward_let_tabs",
            "forward_let_tapp",
            "synquid",
            "tactics",
            "tdsyn_enumerative",
            "tdsyn_random",
            "bustle_baseline",
            "bustle",
            "decision_tree",
            "noisy",
            "structure_guided",
            "contata",
            "boolean_bounded",
            "ortools",
            "polynomial",
            "smt",
            "sygus",
            "afta",
            "cata",
            "fta",
            "arborist",
            "lta",
            "symetric",
            "amaze",
            "enumerative",
            "random_search",
            "regus",
            "rl_mcts",
            "dp_gp",
            "gp",
            "llm_codellama-13b",
            "llm_deepseek-coder-v2-16b",
            "llm_deepseek-coder-6.7b",
            "llm_openai",
            "llm_qwen2.5-coder-14b",
            "llm_qwen2.5-coder-32b",
            "llm_starcoder2-15b",
            "llm_type_constrained",
            "tdsyn",
            "ortools_int",
            "cpsat",
            "xfta",
            "llm"
          ],
          "enumDescriptions": [
            "Type-directed: Backward step (abstraction)",
            "Type-directed: Backward step (application)",
            "Type-directed: Backward step (close with a variable)",
            "Type-directed: Backward step (combined)",
            "Type-directed: Backward step (if-then-else)",
            "Type-directed: Backward step (literal)",
            "Type-directed: Forward step (close with a variable)",
            "Type-directed: Forward step (let: abstraction)",
            "Type-directed: Forward step (let: application)",
            "Type-directed: Forward step (let: if-then-else)",
            "Type-directed: Forward step (let: type abstraction)",
            "Type-directed: Forward step (let: type application)",
            "Type-directed: Synquid enumeration (Q-guided)",
            "Type-directed: Tactic search (random)",
            "Type-directed: Type-directed synthesis (BFS)",
            "Type-directed: Type-directed synthesis (Random Walk)",
            "Example-driven: BUSTLE bottom-up search (unguided)",
            "Example-driven: BUSTLE learning-guided bottom-up search",
            "Example-driven: Decision tree regression (from examples)",
            "Example-driven: Noisy examples (regularized adaptive sampling)",
            "Example-driven: Structure-guided recursive synthesis (from examples)",
            "Example-driven: Version-space synthesis (from I/O examples)",
            "Constraint solving: Bounded Boolean CNF (Z3 CEGIS)",
            "Constraint solving: CP-SAT optimisation (OR-Tools)",
            "Constraint solving: Polynomial certificates (Handelman / SOS)",
            "Constraint solving: SMT model finding (Z3)",
            "Constraint solving: SyGuS translation (CVC5)",
            "Automata: Abstraction-refinement FTA (from examples)",
            "Automata: Constraint tree automata (relational)",
            "Automata: Finite tree automata (library compose)",
            "Automata: Lifted interpretation (local binding contexts)",
            "Automata: Liquid tree automata (refined compose)",
            "Automata: Metric-guided composition (diversity)",
            "Grammar search: AMaze grammar optimization (stdlib-trained)",
            "Grammar search: Native grammar enumeration (BFS)",
            "Grammar search: Native grammar random search",
            "Grammar search: ReGuS reward-guided controller synthesis",
            "Grammar search: RL-guided Monte-Carlo grammar tree search",
            "Metaheuristic: Dynamic-programming transformations (GP components)",
            "Metaheuristic: Native genetic programming (linear genome)",
            "LLM-assisted: LLM generation (codellama:13b)",
            "LLM-assisted: LLM generation (deepseek-coder-v2:16b)",
            "LLM-assisted: LLM generation (deepseek-coder:6.7b)",
            "LLM-assisted: LLM generation (OpenAI-compatible)",
            "LLM-assisted: LLM generation (qwen2.5-coder:14b)",
            "LLM-assisted: LLM generation (qwen2.5-coder:32b)",
            "LLM-assisted: LLM generation (starcoder2:15b)",
            "LLM-assisted: Type-constrained LLM generation (local Transformers)",
            "Alias for tdsyn_enumerative: Type-directed synthesis (BFS)",
            "Alias for ortools: CP-SAT optimisation (OR-Tools)",
            "Alias for ortools: CP-SAT optimisation (OR-Tools)",
            "Alias for symetric: Metric-guided composition (diversity)",
            "Alias for llm_qwen2.5-coder-32b: LLM generation (qwen2.5-coder:32b)"
          ],
          "description": "Preferred synthesizer shown first in the Synthesize code-action menu when a hole is selected."
        },
        "aeon.infoView.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Aeon Info View (goal, expression type and typing context at the cursor) when an Aeon file is open on startup."
        }
      }
    },
    "commands": [
      {
        "command": "aeon.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "aeon.showSetupGuide",
        "title": "Docs : Show Setup Guide",
        "description": "Show Aeon setup guide",
        "category": "Aeon"
      },
      {
        "command": "aeon.showDocResources",
        "title": "Docs : Open Aeon Documentation",
        "category": "Aeon"
      },
      {
        "command": "aeon.setup.installUv",
        "title": "Setup : Install Uv",
        "category": "Aeon"
      },
      {
        "command": "aeon.setup.updateUv",
        "title": "Setup : Update Uv",
        "category": "Aeon"
      },
      {
        "command": "aeon.setup.uninstallUv",
        "title": "Setup : Uninstall Uv",
        "category": "Aeon"
      },
      {
        "command": "aeon.troubleshooting.showOutput",
        "title": "Troubleshooting : Show Output",
        "category": "Aeon"
      },
      {
        "command": "aeon.restartServer",
        "title": "Restart Server",
        "category": "Aeon"
      },
      {
        "command": "aeon.input.convert",
        "title": "Input : Convert Current Abbreviation",
        "category": "Aeon"
      },
      {
        "command": "aeon.infoView.toggle",
        "title": "Info View : Toggle",
        "category": "Aeon"
      },
      {
        "command": "aeon.infoView.open",
        "title": "Info View : Open",
        "category": "Aeon"
      }
    ],
    "grammars": [
      {
        "language": "aeon",
        "scopeName": "source.aeon",
        "path": "./syntaxes/aeon.json",
        "embeddedLanguages": {
          "source.python": "python"
        }
      }
    ],
    "languages": [
      {
        "id": "aeon",
        "configuration": "./language-configuration.json",
        "extensions": [
          ".ae"
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aeon.showSetupGuide"
        },
        {
          "command": "aeon.showDocResources"
        },
        {
          "command": "aeon.setup.installUv"
        },
        {
          "command": "aeon.setup.updateUv"
        },
        {
          "command": "aeon.setup.uninstallUv"
        },
        {
          "command": "aeon.troubleshooting.showOutput"
        },
        {
          "command": "aeon.restartServer"
        },
        {
          "command": "aeon.input.convert",
          "when": "editorLangId == aeon"
        },
        {
          "command": "aeon.infoView.toggle"
        },
        {
          "command": "aeon.infoView.open"
        }
      ]
    },
    "semanticTokenScopes": [
      {
        "scopes": {
          "keyword": [
            "keyword.other"
          ]
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "aeon.welcome",
        "title": "Aeon Setup",
        "description": "Getting started with Aeon\n",
        "steps": [
          {
            "id": "aeon.welcome.openSetupGuide",
            "title": "Re-Open Setup Guide",
            "description": "This guide can always be re-opened by running the command 'Aeon : Docs : Show Setup Guide'.",
            "media": {
              "image": "media/openguide.png",
              "altText": "Click on the Top menu bar, select 'Show and Run Commands >', then 'Aeon : Docs : Show Setup Guide'"
            }
          },
          {
            "id": "aeon.welcome.documentation",
            "title": "Documentation",
            "description": "Learn using Aeon with the resources on the right.",
            "media": {
              "markdown": "./media/guide-documentation.md"
            }
          },
          {
            "id": "aeon.welcome.installDeps.linux",
            "title": "Install Required Dependencies",
            "description": "Install Git and curl using your package manager.",
            "media": {
              "markdown": "./media/guide-installDeps-linux.md"
            },
            "when": "isLinux"
          },
          {
            "id": "aeon.welcome.installDeps.mac",
            "title": "Install Required Dependencies",
            "description": "Install Homebrew, Git and curl.",
            "media": {
              "markdown": "./media/guide-installDeps-mac.md"
            },
            "when": "isMac"
          },
          {
            "id": "aeon.welcome.installDeps.windows",
            "title": "Install Required Dependencies",
            "description": "Install Git.",
            "media": {
              "markdown": "./media/guide-installDeps-windows.md"
            },
            "when": "isWindows"
          },
          {
            "id": "aeon.welcome.installUv.unix",
            "title": "Install uv Python Environment Manager",
            "description": "Install uv, the fast Python package installer and resolver.\n[Click to install](command:aeon.setup.installUv)",
            "media": {
              "markdown": "./media/guide-installUv-unix.md"
            },
            "when": "isLinux || isMac"
          },
          {
            "id": "aeon.welcome.installUv.windows",
            "title": "Install uv Python Environment Manager",
            "description": "Install uv, the fast Python package installer and resolver.\n[Click to install](command:aeon.setup.installUv)",
            "media": {
              "markdown": "./media/guide-installUv-windows.md"
            },
            "when": "isWindows"
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onViewWelcome:aeon.welcome",
    "onLanguage:aeon"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "npm run compile",
    "test": "esbuild src/synthesis.ts --bundle --platform=node --outfile=out/synthesis.cjs && node --test test/*.test.cjs",
    "compile": "esbuild src/extension.ts --bundle --platform=node --target=node16 --outfile=out/extension.js --external:vscode",
    "lint": "eslint",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node16 --outfile=out/extension.js --external:vscode --watch",
    "package": "vsce package --no-dependencies",
    "packagePreRelease": "vsce package --no-dependencies --pre-release"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "ovsx": "^0.10.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "icon": "images/aeon_logo.png",
  "dependencies": {
    "@vscode-elements/elements": "^2.0.0",
    "@vscode/codicons": "^0.0.41",
    "dotenv": "^17.0.1",
    "semver": "^7.6.0",
    "vscode-languageclient": "^9.0.1",
    "yarn": "^1.22.22"
  },
  "__metadata": {
    "id": "aeon-lang",
    "publisherDisplayName": "AlcidesFonseca",
    "publisherId": "cad44106-bddd-6cd4-a711-3354f600f23c",
    "isPreReleaseVersion": false
  }
}
